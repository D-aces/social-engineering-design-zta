CREATE DATABASE IF NOT EXISTS credential_db;
USE credential_db;
CREATE TABLE IF NOT EXISTS credentials (
  user_id VARCHAR(64) PRIMARY KEY,                 -- Unique user ID
  hashed_token VARCHAR(256) NOT NULL,              -- Hashed password or token
  role VARCHAR(64) NOT NULL,                       -- Role for access control
  allowed_locations JSON,                          -- Optional JSON array of locations
  is_active BOOLEAN DEFAULT TRUE,                  -- Whether the account is active
  last_updated TIMESTAMP DEFAULT CURRENT_TIMESTAMP -- Last update timestamp
);

